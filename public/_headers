# Custom headers.
# See e.g.
# - https://infosec.mozilla.org/guidelines/web_security#x-frame-options
# - https://www.netlify.com/docs/headers-and-basic-auth/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdnjs.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self';
