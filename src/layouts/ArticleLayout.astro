---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  date: Date;
  lang?: string;
}

const { title, date, lang } = Astro.props;
---

<PageLayout title={title} lang={lang}>
  <article class="blog-post">
    <h1 class="blog-post-title">{title}</h1>
    <p class="blog-post-meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString(lang === 'is' ? 'is-IS' : 'en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    </p>
    <slot />
  </article>
</PageLayout>
