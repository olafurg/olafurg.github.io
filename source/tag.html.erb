---
pageable: true
per_page: 10
layout: page_layout
---

<% current_page.data.title = "Articles tagged '#{tagname}'" %>

<h1>Articles tagged '<%= tagname %>'</h1>

<% page_articles.each_with_index do |article, i| %>
  <div class="blog-list-item">
    <span class="blog-post-link">
      <%= link_to article.title, article %>
    </span>
    <span class="blog-post-meta">
      <time datetime="<%= article.date %>">
        <%= article.date.strftime('%B %e, %Y') %>
      </time>
    </span>
  </div>
<% end %>

<% if paginate %>
  <nav class="blog-pagination">
    <% if prev_page %>
      <%= link_to 'Newer', prev_page, { class: "btn btn-outline-primary" } %>
    <% end %>
    <% if next_page %>
      <%= link_to 'Older', next_page, { class: "btn btn-outline-primary" } %>
    <% end %>
  </nav>
<% end %>
